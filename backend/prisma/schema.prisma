// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"

}

enum TypeMovement {
  INCOME
  EXPENSE
  SAVING
  INVESTMENT
}

enum typePeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  FREELANCE
}

enum statusPage {
  ACTIVE
  CLOSED
}

enum typeMovementSave {
  CONTRIBUTION
  WITHDRAWAL
}

enum typeInvestment {
  CONTRIBUTION
  WITHDRAWAL
  REVENUE
  LOSS
}

enum typeIntitution {
  BANK
  CASH
  CRYPTO
}
enum statusUser {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}
enum statusSession {
  ON
  OFF
}
enum nameBalance {
  AVAILABLE
  TOTAL
  SAVINGS
  INVESTMENTS
  GOALSAVING
}


model User {
  id     String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  password String?
  typePeriod typePeriod? @map("type_period")
  profilePicture String? @map("profile_picture")
  verifyEmail Boolean @default(false) @map("verify_email")
  timeZone String? @default("BOG") @map("time_zone")
  googleId String? @unique @map("google_id")
  status statusUser? @default(ACTIVE)
  language String? @default("ES")
  country String? @default("COL")
  currency String? @default("COP")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  sessions UserSession[]
  loginConfigurations LoginConfiguration[]
  financialPages FinancialPages[]
  financialInstitutions FinancialInstitutions[]
  userConsents UserConsent[]
  balanceAdjustments BalanceAdjustments[]
  balanceSections BalanceSection[]
  investmentAccounts investmentAccounts[]
  categories Categories[]


  @@index([email])
  @@index([id])
  @@map("users")
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid @map("user_id")
  refreshToken String @map("refresh_token")
  userAgent String? @map("user_agent")
  ipAddress String?
  country String? 
  status statusSession? @default(ON)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions_users")
}


model LoginConfiguration {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  pay_frequency String? @map("pay_frequency")
  pay_day_one String? @map("pay_day")
  pay_day_two String? @map("pay_day_two")
  activeNotifications Boolean? @default(true) @map("active_notifications")
  createdAt DateTime @default(now()) @map("created_at")

  payDays PayDays[]

  user User @relation(fields: [userId], references: [id])
  @@map("login_configurations")
}



model FinancialPages {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  name String
  startDate DateTime @map("start_date")
  endDate DateTime? @map("end_date")
  status statusPage? @default(ACTIVE)
  totalIncome Decimal? @default(0.0) @map("total_income")
  totalExpenses Decimal? @default(0.0) @map("total_expenses")
  
  closedAt DateTime? @map("closed_at")
  createdAt DateTime @default(now()) @map("created_at")

  balanceAdjustments BalanceAdjustments[]
  movements Movements[]


  user User @relation(fields: [userId], references: [id])

  @@index([id])
  @@index([userId])
  @@map("financial_pages")
}

model FinancialInstitutions {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  name String
  type typeIntitution?
  balanceNow Decimal? @db.Decimal(12,2) @default(0.0) @map("balance_now")
  status String? @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  movements Movements[]

  user User @relation(fields: [userId], references: [id])
  @@map("financial_institutions")
}

model UserConsent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  consentType String @map("type_consent")
  version String
  accepted Boolean @default(false)
  dateAssigned DateTime @default(now()) @map("date_assigned")

  user User @relation(fields: [userId], references: [id])
  @@map("user_consents")
}

model PayDays {
  id String @id @default(uuid()) @db.Uuid 
  configurationId String @db.Uuid @map("configuration_id")
  dayMonth Int @map("day_month")
  createdAt DateTime @default(now()) @map("created_at")

  configuration LoginConfiguration @relation(fields: [configurationId], references: [id])
  @@map("paydays")
}

model Categories {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String
  isRecurrent Boolean? @default(false) @map("is_recurrent")
  status String @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("update_at")

  movements Movements[]
  investmentAccounts investmentAccounts[]
  
  user User @relation(fields: [userId] , references: [id])

  @@index([id])
  @@index([userId])

}

model BalanceAdjustments {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  financialPageId String @db.Uuid @map("financial_page_id")
  amount Decimal @db.Decimal(12,2) @map("amount")
  reason String @map("reason")
  dateAdjustment DateTime @map("date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  financialPage FinancialPages @relation(fields: [financialPageId], references: [id])

  @@map("balance_adjustments")

}

model  Movements {
  id String @id @default(uuid()) @db.Uuid
  financialPageId String @db.Uuid @map("financial_page_id")
  categoryId String @db.Uuid @map("category_id")
  institutionFinancialId String? @db.Uuid @map("institution_financial_id")
  balanceSectionId String @db.Uuid @map("balance_section_id")
  description String?
  amount Decimal @db.Decimal(12,2)  @map("amount")
  expectAmount Decimal? @map("expect_amount")
  receipUrl String? @map("receip_url")
  date DateTime @map("date")
  isPay Boolean @default(false) @map("is_pay")
  typeMovement TypeMovement @map("type_movement")
  createdAt DateTime @default(now()) @map("created_at")

  financialPage FinancialPages @relation(fields: [financialPageId], references: [id])
  category Categories @relation(fields: [categoryId], references: [id])
  institutionFinancial FinancialInstitutions? @relation(fields: [institutionFinancialId], references: [id])
  balanceSection  BalanceSection @relation(fields: [balanceSectionId], references: [id])

  @@index([categoryId])
  @@index([date])
  @@map("movements")
}

model BalanceSection {
  id  String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  nameBalance nameBalance @map("name_balance")
  balance Decimal @db.Decimal(12 , 2)  @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  movements Movements[]

  user User @relation(fields: [userId], references: [id])

  @@map("balance_sections")
}

model investmentAccounts {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  categoryItemId String @db.Uuid @map("category_item_id")
  name String
  typeInvestment typeInvestment @map("type_investment")
  whereInvestment String @map("where_investment")
  balance Decimal @db.Decimal(12,2) @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")

  movements MovementsInvestmentAccounts[]

  user User @relation(fields: [userId], references: [id])
  categoryItem Categories@relation(fields: [categoryItemId], references: [id])

  @@map("investment_accounts")
}

model MovementsInvestmentAccounts {
  id String @id @default(uuid()) @db.Uuid
  investmentAccountId String @db.Uuid @map("investment_account_id")
  typeMovement TypeMovement @map("type_movement")
  amount Decimal @db.Decimal(12,2) @map("amount")
  date DateTime @map("date")
  reason String
  createdAt DateTime @default(now()) @map("created_at")

  investmentAccount investmentAccounts @relation(fields: [investmentAccountId], references: [id])

  @@map("movements_investment_accounts")
}